# FileVault Environment Configuration

# Server Port (Default: 5000)
PORT=5000
NODE_ENV=development

# Session Secret (used for signing session cookies)
SESSION_SECRET=filevault-super-secure-secret-key-change-in-production

# --- Firebase Configuration ---
# Set to 'true' to use the live Firebase Admin SDK & Cloud Firestore / Storage.
# If omitted or false, FileVault runs in an integrated local-emulated storage mode
# allowing full local testing, development, and offline functionality without external billing.
USE_FIREBASE_LIVE=false

# Firebase Admin SDK Credentials (JSON string or path to serviceAccountKey.json)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
FIREBASE_PROJECT_ID=file-vault-4cce3
FIREBASE_STORAGE_BUCKET=filevault-demo.appspot.com

# Firebase Client Web Configuration (Vite client environment variables)
VITE_FIREBASE_API_KEY=AIzaSyDemoKeyFileVault1234567890
VITE_FIREBASE_AUTH_DOMAIN=filevault-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=filevault-demo
VITE_FIREBASE_STORAGE_BUCKET=filevault-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# --- Gemini AI Configuration ---
# Server-side API key for Gemini Document Intelligence (Never expose to client/browser)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model ID (e.g., gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# --- Supabase Configuration ---
# Your Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Public Key
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Secret (Keep secure, used by backend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Storage Bucket name (Default: documents)
SUPABASE_STORAGE_BUCKET=documents

# Client-side Supabase Configuration (for Vite frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here