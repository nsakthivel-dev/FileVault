rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidStatus(status) {
      return status in [
        'Uploaded', 'Processing', 'Verified', 'Unverified', 'Rejected', 'Expired',
        'uploaded', 'processing', 'review_required', 'completed', 'failed', 'duplicate'
      ];
    }

    function isValidCategory(category) {
      return category in [
        'resume', 'certificate', 'achievement', 'hackathon', 'education', 'marksheet',
        'degree', 'internship', 'employment', 'offer_letter', 'experience_letter',
        'course', 'workshop', 'project', 'participation', 'identity', 'certificates',
        'professional', 'government', 'other'
      ];
    }

    // User profiles & user subcollections
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.email is string;
      allow update: if isOwner(userId);
      allow delete: if false; // Disallow accidental user deletion via client

      // Direct user document subcollection: users/{userId}/documents/{documentId}
      match /documents/{documentId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
                      && request.resource.data.ownerId == userId
                      && isValidCategory(request.resource.data.documentType);
        allow update: if isOwner(userId)
                      && request.resource.data.ownerId == userId;
      }
    }

    // Documents collection (top-level collection query support)
    match /documents/{documentId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isAuthenticated() 
                    && request.resource.data.ownerId == request.auth.uid
                    && isValidCategory(request.resource.data.documentType);
      allow update: if isOwner(resource.data.ownerId) 
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(resource.data.ownerId);
    }

    // Shares collection
    match /shares/{shareId} {
      // Document owner has full access
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerId);
      // Controlled public read for valid active shares
      allow get: if isOwner(resource.data.ownerId) || (
        resource.data.status == 'ACTIVE' &&
        (resource.data.expiresAt == null || request.time < timestamp.date(resource.data.expiresAt)) &&
        (resource.data.accessLimit == null || resource.data.accessCount < resource.data.accessLimit)
      );
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Audit Logs collection (tamper-resistant, immutable)
    match /auditLogs/{logId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Audit logs cannot be modified or removed by clients
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read, update: if isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
